local function Create(className, props, children)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

-- Helper for radial corner glow cards (Emerald / Crimson / Blurple / Amber)
local function ApplyCardGlow(cardFrame, accentColor, glowPosition)
    cardFrame.BackgroundColor3 = Color3.fromRGB(9, 10, 13)
    cardFrame.ClipsDescendants = true

    local surfaceGrad = Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, accentColor:Lerp(Color3.fromRGB(9, 10, 13), 0.58)),
            ColorSequenceKeypoint.new(0.52, Color3.fromRGB(11, 12, 16)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 9, 12))
        }),
        Rotation = (glowPosition == "TopLeft") and 35 or -35,
        Parent = cardFrame
    })

    local bloom = Create("ImageLabel", {
        Name = "CornerGlow",
        BackgroundTransparency = 1,
        Image = "rbxassetid://5554236805",
        ImageColor3 = accentColor,
        ImageTransparency = 0.52,
        Size = UDim2.new(0, 260, 0, 220),
        Position = (glowPosition == "TopLeft") and UDim2.new(0, -95, 0, -95) or UDim2.new(0, -90, 1, -135),
        ZIndex = 1,
        Parent = cardFrame
    })

    local stroke = Create("UIStroke", {
        Thickness = 1,
        Color = Color3.fromRGB(255, 255, 255),
        Transparency = 0.25,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = cardFrame
    })

    Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, accentColor),
            ColorSequenceKeypoint.new(0.45, Color3.fromRGB(55, 58, 70)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(32, 34, 42))
        }),
        Rotation = (glowPosition == "TopLeft") and 35 or -35,
        Parent = stroke
    })

    return surfaceGrad, bloom
end

