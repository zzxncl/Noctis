local function GetPlayerAvatarBust(userId)
    local fallbackUrl = string.format("rbxthumb://type=AvatarBust&id=%d&w=150&h=150", userId)
    local ok, content = pcall(function()
        return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size150x150)
    end)
    if ok and content and content ~= "" then
        return content
    end
    return fallbackUrl
end

