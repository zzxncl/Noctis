local function SwitchTab(tabId)
    for id, btn in pairs(TabButtons) do
        local isSelected = (id == tabId)
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = isSelected and Color3.fromRGB(39, 41, 53) or Color3.fromRGB(24, 25, 32),
            BackgroundTransparency = isSelected and 0 or 1,
            TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 154, 168)
        }):Play()
    end
    for id, page in pairs(TabPages) do
        page.Visible = (id == tabId)
    end
end

