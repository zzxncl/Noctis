-- // 13. LIVE TELEMETRY & FRIENDS UPDATER
local StartClock = os.clock()

local function UpdateFriendsStats()
    task.spawn(function()
        local inServerCount = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local isFriend = false
                pcall(function()
                    isFriend = LocalPlayer:IsFriendsWith(plr.UserId)
                end)
                if isFriend then
                    inServerCount += 1
                end
            end
        end
        InServerFriendsLabel.Text = (inServerCount == 0) and "no friends" or (tostring(inServerCount) .. " friends")

        local totalFriends = 0
        local onlineFriends = 0

        pcall(function()
            local onlineList = LocalPlayer:GetFriendsOnline(200)
            if type(onlineList) == "table" then
                onlineFriends = #onlineList
            end
        end)

        pcall(function()
            local pages = Players:GetFriendsAsync(LocalPlayer.UserId)
            while true do
                local items = pages:GetCurrentPage()
                for _ in ipairs(items) do
                    totalFriends += 1
                end
                if pages.IsFinished then
                    break
                end
                pages:AdvanceToNextPageAsync()
            end
        end)

        local offlineFriends = math.max(0, totalFriends - onlineFriends)
        OnlineFriendsLabel.Text = tostring(onlineFriends) .. " friends"
        OfflineFriendsLabel.Text = tostring(offlineFriends) .. " friends"
        AllFriendsLabel.Text = tostring(totalFriends) .. " Friends"
    end)
end

UpdateFriendsStats()
Players.PlayerAdded:Connect(function()
    PlayersValueLabel.Text = tostring(#Players:GetPlayers()) .. " playing"
    UpdateFriendsStats()
end)
Players.PlayerRemoving:Connect(function()
    task.defer(function()
        PlayersValueLabel.Text = tostring(#Players:GetPlayers()) .. " playing"
        UpdateFriendsStats()
    end)
end)

task.spawn(function()
    while ScreenGui.Parent do
        local elapsed = math.floor(os.clock() - StartClock)
        local hrs = math.floor(elapsed / 3600)
        local mins = math.floor((elapsed % 3600) / 60)
        local secs = elapsed % 60
        SessionTimeLabel.Text = string.format("%02d:%02d:%02d", hrs, mins, secs)

        local pingMs = 0
        pcall(function()
            pingMs = math.floor(LocalPlayer:GetNetworkPing() * 1000)
        end)
        if pingMs <= 0 then
            pcall(function()
                pingMs = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
        end
        LatencyValueLabel.Text = tostring(pingMs) .. "ms"

        task.wait(1)
    end
end)

