-- // 1. UNIVERSAL GUI PARENTING (Works on every executor)
local function GetSafeGuiParent()
    local success, result = pcall(function()
        if type(gethui) == "function" then
            return gethui()
        end
    end)
    if success and result then
        return result
    end

    local coreSuccess, coreResult = pcall(function()
        return CoreGui
    end)
    if coreSuccess and coreResult then
        return coreResult
    end

    return LocalPlayer:WaitForChild("PlayerGui")
end

-- Remove any existing Noctis instance on re-execute
local GuiParent = GetSafeGuiParent()
for _, child in ipairs(GuiParent:GetChildren()) do
    if child.Name == "NoctisHub_UI" then
        pcall(function() child:Destroy() end)
    end
end

-- // 2. UNIVERSAL EXECUTOR DETECTION
local function DetectExecutor()
    local execName = "Unknown Executor"
    local execVersion = ""
    local supported = true

    pcall(function()
        if type(identifyexecutor) == "function" then
            local name, ver = identifyexecutor()
            if name and tostring(name) ~= "" then
                execName = tostring(name)
                execVersion = ver and tostring(ver) or ""
                return
            end
        end
        if type(getexecutorname) == "function" then
            local name = getexecutorname()
            if name and tostring(name) ~= "" then
                execName = tostring(name)
                return
            end
        end
        if syn then
            execName = "Synapse"
        elseif fluxus then
            execName = "Fluxus"
        elseif KRNL_LOADED then
            execName = "Krnl"
        elseif is_sirhurt_closure then
            execName = "SirHurt"
        end
    end)

    return execName, execVersion, supported
end

-- // 3. UNIVERSAL CLIPBOARD HELPER
local function CopyToClipboard(text)
    local copied = false
    pcall(function()
        if type(setclipboard) == "function" then
            setclipboard(tostring(text))
            copied = true
        elseif type(toclipboard) == "function" then
            toclipboard(tostring(text))
            copied = true
        elseif Clipboard and type(Clipboard.set) == "function" then
            Clipboard.set(tostring(text))
            copied = true
        end
    end)
    return copied
end

